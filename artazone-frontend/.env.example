# URL backend Laravel (TANPA trailing slash, WAJIB menyertakan /api di akhir).
# Dipakai oleh src/api/client.js sebagai baseURL untuk semua panggilan API,
# dan sebagai dasar untuk resolve URL file di /storage (lihat src/utils/resolveIconUrl.js).
#
# - Development lokal (backend Laravel jalan di localhost):
#   VITE_API_URL=http://localhost:8000/api
#
# - Production (Render):
#   VITE_API_URL=https://artazone-api.onrender.com/api
VITE_API_URL=https://artazone-api.onrender.com/api
