# URL backend Laravel (TANPA trailing slash, WAJIB menyertakan /api di akhir).
# Dipakai oleh src/api/client.js sebagai baseURL untuk semua panggilan API,
# dan sebagai dasar untuk resolve URL file di /storage (lihat src/utils/resolveIconUrl.js).
#
# - Development lokal (backend Laravel jalan di localhost):
#   VITE_API_URL=http://localhost:8000/api
#
# - Production (Render):
#   VITE_API_URL=https://artazone-api.onrender.com/api
VITE_API_URL=https://artazone-api.onrender.com/api

# URL publik bucket Cloudflare R2 (TANPA trailing slash), dipakai src/utils/resolveIconUrl.js
# untuk menampilkan icon kategori & bukti transfer yang disimpan sebagai path relatif.
# Didapat dari dashboard Cloudflare -> R2 -> nama bucket -> Settings -> Public Access.
# Contoh: https://pub-xxxxxxxxxxxxxxxx.r2.dev
VITE_R2_PUBLIC_URL=https://pub-96947269fe4c40ba993175405dae953b.r2.dev